NODE_ENV=development
PORT=3000

# PostgreSQL
# Homebrew Postgres: user = your macOS username, empty password.
# Postgres.app / Docker: usually postgres / postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=student_app

# Required — no defaults. Server will not start if missing/invalid.
# Pass mark for subject averages (0–100, decimals allowed).
PASS_PERCENTAGE=40
# Academic year as YYYY-YY where the second year is first+1 (e.g. 2026-27).
ACADEMIC_YEAR=2026-27
