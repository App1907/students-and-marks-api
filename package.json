{
  "name": "student-marks-api",
  "version": "1.0.0",
  "description": "Student CRUD, Marks CRUD and subject-wise averages — Express 5 + TypeScript + PostgreSQL.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "nodemon dist/server.js",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
